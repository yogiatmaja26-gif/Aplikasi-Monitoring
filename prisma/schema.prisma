// Prisma Schema for MySQL 8+
// RAP Material Control System (PLAN → PURCHASE → RECEIVE → INSTALL → MONITOR → REPORT)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  PURCHASING
  SUPERVISOR
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ONGOING
  COMPLETED
  ARCHIVED
}

enum PaymentStatus {
  UNPAID
  DP
  PARTIALLY_PAID
  PAID
}

enum ProcurementStatus {
  NOT_PURCHASED
  DP_PARTIALLY_PURCHASED
  PURCHASED
}

enum ReceivingStatus {
  NOT_RECEIVED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
}

enum InstallationStatus {
  NOT_INSTALLED
  PARTIALLY_INSTALLED
  INSTALLED
}

enum ImageType {
  REFERENCE
  PURCHASE
  DELIVERY
  INSTALLATION
  OTHER
}

model User {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(191)
  email         String         @unique @db.VarChar(191)
  password_hash String         @db.VarChar(255)
  role          Role           @default(VIEWER)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  purchase_transactions   PurchaseTransaction[]
  material_receipts       MaterialReceipt[]
  installation_transactions InstallationTransaction[]
  material_images         MaterialImage[]
  project_documents       ProjectDocument[]
  activity_logs           ActivityLog[]

  @@map("users")
}

model Project {
  id              Int            @id @default(autoincrement())
  project_code    String         @unique @db.VarChar(50)
  project_name    String         @db.VarChar(255)
  description     String?        @db.Text
  location        String?        @db.VarChar(255)
  start_date      DateTime?
  target_end_date DateTime?
  status          ProjectStatus  @default(PLANNING)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  work_categories   WorkCategory[]
  materials         Material[]
  project_documents ProjectDocument[]

  @@index([project_code])
  @@map("projects")
}

model WorkCategory {
  id            Int        @id @default(autoincrement())
  project_id    Int
  category_name String     @db.VarChar(255)
  description   String?    @db.Text
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  project       Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  materials     Material[]

  @@index([project_id])
  @@map("work_categories")
}

model Vendor {
  id             Int        @id @default(autoincrement())
  vendor_name    String     @db.VarChar(255)
  contact_person String?    @db.VarChar(191)
  phone          String?    @db.VarChar(50)
  email          String?    @db.VarChar(191)
  address        String?    @db.Text
  notes          String?    @db.Text
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  materials             Material[]
  purchase_transactions PurchaseTransaction[]

  @@map("vendors")
}

model Material {
  id                     Int                @id @default(autoincrement())
  project_id             Int
  category_id            Int
  vendor_id              Int?
  material_code          String             @unique @db.VarChar(100)
  material_name          String             @db.VarChar(255)
  specification          String?            @db.Text
  unit                   String             @db.VarChar(50)
  planned_quantity       Decimal            @db.Decimal(12, 4)
  rap_unit_price         Decimal            @db.Decimal(15, 2)
  rap_total_price        Decimal            @db.Decimal(15, 2)
  location               String?            @db.VarChar(255)
  notes                  String?            @db.Text
  source_excel_reference String?            @db.VarChar(255)
  procurement_status     ProcurementStatus  @default(NOT_PURCHASED)
  receiving_status       ReceivingStatus    @default(NOT_RECEIVED)
  installation_status    InstallationStatus @default(NOT_INSTALLED)
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  project       Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  category      WorkCategory  @relation(fields: [category_id], references: [id], onDelete: Restrict)
  vendor        Vendor?       @relation(fields: [vendor_id], references: [id], onDelete: SetNull)

  purchase_transactions   PurchaseTransaction[]
  material_receipts       MaterialReceipt[]
  installation_transactions InstallationTransaction[]
  material_images         MaterialImage[]
  project_documents       ProjectDocument[]

  @@index([project_id])
  @@index([category_id])
  @@index([vendor_id])
  @@index([material_code])
  @@map("materials")
}

model PurchaseTransaction {
  id                 Int           @id @default(autoincrement())
  material_id        Int
  vendor_id          Int?
  purchase_date      DateTime
  quantity           Decimal       @db.Decimal(12, 4)
  unit               String        @db.VarChar(50)
  unit_price         Decimal       @db.Decimal(15, 2)
  total_price        Decimal       @db.Decimal(15, 2)
  payment_status     PaymentStatus @default(UNPAID)
  dp_amount          Decimal       @default(0.00) @db.Decimal(15, 2)
  paid_amount        Decimal       @default(0.00) @db.Decimal(15, 2)
  remaining_payment  Decimal       @default(0.00) @db.Decimal(15, 2)
  invoice_number     String?       @db.VarChar(100)
  invoice_file_url   String?       @db.Text
  notes              String?       @db.Text
  created_by         Int?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  material  Material          @relation(fields: [material_id], references: [id], onDelete: Cascade)
  vendor    Vendor?           @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
  creator   User?             @relation(fields: [created_by], references: [id], onDelete: SetNull)
  receipts  MaterialReceipt[]

  @@index([material_id])
  @@index([vendor_id])
  @@index([created_by])
  @@map("purchase_transactions")
}

model MaterialReceipt {
  id                      Int                 @id @default(autoincrement())
  material_id             Int
  purchase_transaction_id Int
  received_date           DateTime
  quantity_received       Decimal             @db.Decimal(12, 4)
  receiver_name           String?             @db.VarChar(191)
  delivery_photo_url      String?             @db.Text
  notes                   String?             @db.Text
  created_by              Int?
  created_at              DateTime            @default(now())

  material  Material            @relation(fields: [material_id], references: [id], onDelete: Cascade)
  purchase  PurchaseTransaction @relation(fields: [purchase_transaction_id], references: [id], onDelete: Cascade)
  creator   User?               @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([material_id])
  @@index([purchase_transaction_id])
  @@index([created_by])
  @@map("material_receipts")
}

model InstallationTransaction {
  id                     Int       @id @default(autoincrement())
  material_id            Int
  installation_date      DateTime
  quantity_installed     Decimal   @db.Decimal(12, 4)
  unit                   String    @db.VarChar(50)
  location               String?   @db.VarChar(255)
  installer_name         String?   @db.VarChar(191)
  installation_photo_url String?   @db.Text
  notes                  String?   @db.Text
  created_by             Int?
  created_at             DateTime  @default(now())

  material Material @relation(fields: [material_id], references: [id], onDelete: Cascade)
  creator  User?    @relation(fields: [created_by], references: [id], onDelete: SetNull)

  @@index([material_id])
  @@index([created_by])
  @@map("installation_transactions")
}

model MaterialImage {
  id          Int       @id @default(autoincrement())
  material_id Int
  image_type  ImageType @default(REFERENCE)
  image_url   String    @db.Text
  caption     String?   @db.Text
  uploaded_by Int?
  created_at  DateTime  @default(now())

  material Material @relation(fields: [material_id], references: [id], onDelete: Cascade)
  uploader User?    @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([material_id])
  @@index([uploaded_by])
  @@map("material_images")
}

model ProjectDocument {
  id            Int      @id @default(autoincrement())
  project_id    Int
  material_id   Int?
  document_type String   @db.VarChar(100)
  file_name     String   @db.VarChar(255)
  file_url      String   @db.Text
  uploaded_by   Int?
  created_at    DateTime @default(now())

  project  Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [material_id], references: [id], onDelete: SetNull)
  uploader User?     @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)

  @@index([project_id])
  @@index([material_id])
  @@map("project_documents")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(100)
  entity_id   Int?
  description String   @db.Text
  created_at  DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([entity_type, entity_id])
  @@map("activity_logs")
}
